# Supabase transaction pooler for Prisma Client (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&sslmode=require"
# Supabase session pooler for Prisma Migrate (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require"

# Cloudflare R2 credentials and bucket used by the worker and site router.
ACCESS=your_r2_access_key
SECRET=your_r2_secret_key
ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
BUCKET=your_bucket

# Preview URLs are http://<deployment-id>.localhost:3000 during local development.
SITE_DOMAIN=localhost
PUBLIC_SITE_PROTOCOL=http
SITE_PORT=3000
PORT=3000

# Browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173

# Maximum time allowed for one install/build process, in milliseconds.
BUILD_TIMEOUT_MS=300000

# Public deployment abuse controls. These do not require user accounts.
DEPLOYMENTS_ENABLED=true
DEPLOY_LIMIT_PER_HOUR=3
DEPLOY_LIMIT_PER_DAY=10
MAX_QUEUED_DEPLOYMENTS=20
RATE_LIMIT_SECRET=replace_with_at_least_32_random_characters
# Number of trusted reverse proxies in front of the API (Render default: 1).
TRUST_PROXY_HOPS=1

# E2B API key used by the deployment worker to create isolated build sandboxes.
E2B_API_KEY=your_e2b_api_key

# Cloudflare Turnstile server-side secret; configure a matching site key in frontend/.env.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Optional hostname returned by Siteverify, e.g. deploy.pushmint.example.
# TURNSTILE_EXPECTED_HOSTNAME=deploy.pushmint.example
