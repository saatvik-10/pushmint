generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentStatus {
  queued
  building
  deployed
  failed
}

enum StaticFramework {
  vite
  next_static
}

model Deployment {
  id              String           @id @default(cuid())
  displayName     String?
  displayNameKey  String?
  repoUrl         String
  framework       StaticFramework  @default(vite)
  buildScript     String           @default("build")
  outputDirectory String           @default("dist")
  status          DeploymentStatus @default(queued)
  siteUrl         String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  completedAt     DateTime?
  logs            DeploymentLog[]

  @@index([createdAt])
  @@index([displayNameKey, createdAt])
  @@index([status, createdAt])
}

model DeploymentLog {
  id           Int        @id @default(autoincrement())
  deploymentId String
  message      String
  createdAt    DateTime   @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, id])
}

model DeploymentRateLimit {
  clientHash  String
  period      String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([clientHash, period, windowStart])
  @@index([expiresAt])
}
